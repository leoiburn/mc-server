# ============================================================================
#  Copy this file to ".env" and fill in real values:  cp .env.example .env
#  The real ".env" is git-ignored so your secrets NEVER go to GitHub.
# ============================================================================

# --- SECRET: password the backup service uses to talk to the server. ---
# Generate a strong one:  openssl rand -base64 24
RCON_PASSWORD=change-me-to-a-long-random-string

# --- Server admins (your in-game username). Comma-separated, no spaces. ---
OPS_USERS=YourMinecraftName

# --- Performance: how much RAM the server may use. ---
# Rule of thumb: leave ~2 GB for the OS. 8GB box -> 6G. 16GB box -> 10G.
MC_MEMORY=6G

# --- Minecraft version (must match your mods). ---
MC_VERSION=1.21.1

# --- Mods: EITHER a Modrinth modpack URL for "many mods" in one shot... ---
# Find a server-capable pack on https://modrinth.com/modpacks, copy the
# .mrpack download URL, and paste it here. Leave blank to use the hand-picked
# MODRINTH_PROJECTS list in docker-compose.yml instead.
MODPACK_URL=

# --- Access control ---
# FALSE = anyone can join, gated by EasyAuth password (what you asked for).
# TRUE  = only real (paid) Minecraft accounts, no password mod needed.
ONLINE_MODE=FALSE

# --- Backups ---
BACKUP_INTERVAL=2h
PRUNE_DAYS=7

# --- Cosmetic / gameplay ---
MOTD=Modded survival — /register <pass> <pass> to play
DIFFICULTY=normal
MAX_PLAYERS=20
VIEW_DISTANCE=10
TZ=America/Mexico_City
